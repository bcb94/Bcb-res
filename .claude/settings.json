{
  "cleanupPeriodDays": 365,
  "enabledPlugins": {
    "stripe@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npx netlify deploy:*)",
      "mcp__Supabase__apply_migration",
      "mcp__f0e72249-77eb-4529-b8d3-8dce00f838fd__apply_migration"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(netlify:*) — routine deploy and status CLI usage for this project",
      "mcp__Supabase__apply_migration — Supabase schema migrations for BCB; each one is committed to supabase/migrations/ before it is applied. Does NOT cover execute_sql.",
      "mcp__f0e72249-77eb-4529-b8d3-8dce00f838fd__apply_migration — the same Supabase server where it is registered by UUID rather than by name. Does NOT cover execute_sql."
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.mjs",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-handoff.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auto-handoff.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
